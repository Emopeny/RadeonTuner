<Page
    x:Class="RadeonTuner.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RadeonTuner"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="page_Loaded"
    RequestedTheme="Dark"
    Background="{ThemeResource ApplicationBlackColor}"
    PointerMoved="PointerMoved_AdjustCursor">

    <Grid>
        <Grid x:Name="grid_Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <ListView x:Name="listview_Main" Grid.Column="0" Padding="0,0,5,0" SelectionMode="Single" SelectionChanged="listview_Main_SelectionChanged" Style="{ThemeResource ApplicationListView}">
                <ListViewItem x:Name="listviewitem_Tuning">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Tuning.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="调校"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Fans" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Fans.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="风扇"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Graphics" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Graphics.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="显卡"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Display" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Display.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="显示"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Multimedia" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Multimedia.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="多媒体"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Settings" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Settings.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="设置"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Information" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Information.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="信息"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Exit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="/Assets/Shutdown.png" Width="50" Height="50"/>
                        <TextBlock HorizontalAlignment="Center" Text="退出"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="8" Margin="5" Padding="6" Background="{ThemeResource ApplicationDarkGrayColor}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="button_Update_Launch" Width="44" Height="44" ToolTipService.ToolTip="有新更新可用" Click="button_Update_Launch_Click" Style="{ThemeResource ApplicationButtonImage}" Margin="0,0,10,0" Visibility="Collapsed">
                                <Image Source="/Assets/Update.png"/>
                            </Button>
                            <Image Source="/Assets/RadeonTuner.png" Width="44" Height="44" ToolTipService.ToolTip="RadeonTuner &lt;3"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <!-- Gpu Select -->
                            <Button x:Name="button_GpuSelect" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前显卡" Click="button_GpuSelect_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image HorizontalAlignment="Center" Source="/Assets/Videocard.png" Width="28" Height="28"/>
                                    <TextBlock x:Name="textblock_GpuSelect" Text="选择显卡" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Display Select -->
                            <Button x:Name="button_DisplaySelect" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前显示器" Click="button_DisplaySelect_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image HorizontalAlignment="Center" Source="/Assets/Display.png" Width="28" Height="28"/>
                                    <TextBlock x:Name="textblock_DisplaySelect" Text="选择显示器" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="stackpanel_AppSelect_Graphics" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Graphics_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Apps.png" Width="28" Height="28"/>
                                        <TextBlock x:Name="textblock_AppSelect_Graphics" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Add -->
                                <Button x:Name="button_AppAdd_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Graphics_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Plus.png" Width="28" Height="28"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Remove -->
                                <Button x:Name="button_AppRemove_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Graphics_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Remove.png" Width="28" Height="28"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="stackpanel_AppSelect_Tuning" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Tuning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Apps.png" Width="28" Height="28"/>
                                        <TextBlock x:Name="textblock_AppSelect_Tuning" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Add -->
                                <Button x:Name="button_AppAdd_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Tuning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Plus.png" Width="28" Height="28"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Remove -->
                                <Button x:Name="button_AppRemove_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Tuning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Remove.png" Width="28" Height="28"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="stackpanel_AppSelect_Display" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Display_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Apps.png" Width="28" Height="28"/>
                                        <TextBlock x:Name="textblock_AppSelect_Display" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Add -->
                                <Button x:Name="button_AppAdd_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Display_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Plus.png" Width="28" Height="28"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Remove -->
                                <Button x:Name="button_AppRemove_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Display_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Remove.png" Width="28" Height="28"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="stackpanel_AppSelect_Multimedia" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Multimedia" IsEnabled="False" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="/Assets/Apps.png" Width="28" Height="28"/>
                                        <TextBlock x:Name="textblock_AppSelect_Multimedia" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status -->
                <Border x:Name="border_Status" Grid.Row="1" CornerRadius="8" Margin="5" Padding="8" Background="{ThemeResource ApplicationDarkGrayColor}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="textblock_Current_Gpu_Activity" Text="..." Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="核心活动"/>
                        <TextBlock x:Name="textblock_Current_Core_Speed" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="核心频率"/>
                        <TextBlock x:Name="textblock_Current_Memory_Activity" Text="" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="显存活动"/>
                        <TextBlock x:Name="textblock_Current_Memory_Speed" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="显存频率"/>
                        <TextBlock x:Name="textblock_Current_Memory_Usage" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="显存占用"/>
                        <TextBlock x:Name="textblock_Current_Power_Wattage" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="功耗"/>
                        <TextBlock x:Name="textblock_Current_Power_Voltage" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="电源电压"/>
                        <TextBlock x:Name="textblock_Current_Fan_Speed_Percentage" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="风扇转速百分比"/>
                        <TextBlock x:Name="textblock_Current_Fan_Speed_RPM" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="风扇转速 RPM"/>
                        <TextBlock x:Name="textblock_Current_Temp_Core" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="核心温度"/>
                        <TextBlock x:Name="textblock_Current_Temp_Memory" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="显存温度"/>
                        <TextBlock x:Name="textblock_Current_Temp_Hotspot" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="热点温度"/>
                        <TextBlock x:Name="textblock_Current_Temp_Intake" Margin="0,0,8,0" FontSize="18" ToolTipService.ToolTip="进气温度"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <VariableSizedWrapGrid x:Name="stackpanel_Tuning_Buttons" Grid.Row="2" ItemWidth="105" ItemHeight="42" Margin="5,0,5,0" Orientation="Horizontal">
                    <Button x:Name="button_Tuning_Apply" Click="button_Tuning_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用调校与风扇设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                    <Button x:Name="button_Tuning_Reset" Click="button_Tuning_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将调校和风扇设置重置为默认值。"/>
                    <Button x:Name="button_Tuning_Import" Click="button_Tuning_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入调校和风扇设置，这些设置不会自动应用。"/>
                    <Button x:Name="button_Tuning_Export" Click="button_Tuning_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前的调校和风扇设置导出到文件。"/>
                </VariableSizedWrapGrid>
                <VariableSizedWrapGrid x:Name="stackpanel_Fan_Buttons" Grid.Row="2" ItemWidth="105" ItemHeight="42" Margin="5,0,5,0" Orientation="Horizontal">
                    <Button x:Name="button_Fan_Apply" Click="button_Tuning_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用调校与风扇设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                    <Button x:Name="button_Fan_Reset" Click="button_Tuning_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将调校和风扇设置重置为默认值。"/>
                    <Button x:Name="button_Fan_Import" Click="button_Tuning_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入调校和风扇设置，这些设置不会自动应用。"/>
                    <Button x:Name="button_Fan_Export" Click="button_Tuning_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前的调校和风扇设置导出到文件。"/>
                </VariableSizedWrapGrid>
                <VariableSizedWrapGrid x:Name="stackpanel_Graphics_Buttons" Grid.Row="2" ItemWidth="125" ItemHeight="42" Margin="5,0,5,0" Orientation="Horizontal">
                    <Button x:Name="button_Graphics_Apply" Click="button_Graphics_Apply_Click" Content="应用" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用显卡设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                    <Button x:Name="button_Graphics_Reset" Click="button_Graphics_Reset_Click" Content="重置" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将显卡设置重置为默认值。"/>
                    <Button x:Name="button_Graphics_Import" Click="button_Graphics_Import_Click" Content="导入" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入显卡设置。"/>
                    <Button x:Name="button_Graphics_Export" Click="button_Graphics_Export_Click" Content="导出" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前显卡设置导出到文件。"/>
                    <Button x:Name="button_Graphics_Clear_ShaderCache" Click="button_Graphics_Clear_ShaderCache_Click" Content="清除着色器" Width="120" ToolTipService.ToolTip="清空磁盘着色器缓存的内容。" Style="{ThemeResource ApplicationButton}"/>
                </VariableSizedWrapGrid>
                <VariableSizedWrapGrid x:Name="stackpanel_Display_Buttons" Grid.Row="2" ItemWidth="105" ItemHeight="42" Margin="5,0,5,0" Orientation="Horizontal">
                    <Button x:Name="button_Display_Apply" Click="button_Display_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用显示设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                    <Button x:Name="button_Display_Reset" Click="button_Display_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将显示设置重置为默认值。"/>
                    <Button x:Name="button_Display_Import" Click="button_Display_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入显示设置。"/>
                    <Button x:Name="button_Display_Export" Click="button_Display_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前显示设置导出到文件。"/>
                </VariableSizedWrapGrid>
                <VariableSizedWrapGrid x:Name="stackpanel_Multimedia_Buttons" Grid.Row="2" ItemWidth="105" ItemHeight="42" Margin="5,0,5,0" Orientation="Horizontal">
                    <Button x:Name="button_Multimedia_Apply" Click="button_Multimedia_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用多媒体设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                    <Button x:Name="button_Multimedia_Reset" Click="button_Multimedia_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将多媒体设置重置为默认值。"/>
                </VariableSizedWrapGrid>
                <VariableSizedWrapGrid x:Name="stackpanel_Information_Buttons" Grid.Row="2" ItemWidth="155" ItemHeight="42" Margin="5,0,5,0" Orientation="Horizontal">
                    <Button x:Name="button_Website_Project" Content="访问项目网站" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Website_Project_Click"/>
                    <Button x:Name="button_Website_Donation" Content="打开捐赠页面" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Website_Donation_Click"/>
                    <Button x:Name="button_Fps_Overlayer" Content="获取 FpsOverlayer" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Fps_Overlayer_Click"/>
                    <Button x:Name="button_Check_Update" Content="检查更新" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Update_Check_Click"/>
                </VariableSizedWrapGrid>

                <!-- Main -->
                <ScrollViewer Grid.Row="3" Margin="5,0,5,0" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,10,10">
                        <!-- Graphics -->
                        <StackPanel x:Name="stackpanel_Graphics" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="FSR 选项" FontSize="20" FontWeight="Medium"/>
                                <Image Grid.Column="1" HorizontalAlignment="Right" Source="/Assets/Warning.png" Margin="6,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="* 更改下方显卡设置可能需要重启应用程序才能生效。&#10;&#10;* 由于驱动程序的限制，在应用程序配置文件中设置的显卡设置会在你的多块显卡之间共享。&#10;&#10;* 像 'Fluid Motion Frames' 和 'Super Resolution' 这类部分设置不可用，因为它们无法在 'Minimal' 和 'Driver Only' 软件类型安装下工作。"/>
                            </Grid>

                            <!-- Radeon FSR Options -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- FSR Latency Reduction -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="FSR 延迟降低 (Anti-Lag) 通过控制 CPU 的工作节奏、确保其不会过度领先 GPU，从而在 GPU 受限的情况下帮助减少输入延迟，启用此设置可能导致小幅帧率损失。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置不适用于 OpenGL 应用程序。&#10;&#10;* 启用 'Radeon Chill' 时无法使用此设置。"/>
                                        <Image x:Name="image_FsrLatencyReduction_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                        <ToggleSwitch x:Name="toggleswitch_FsrLatencyReduction" Margin="10,0,0,0" OffContent="FSR 延迟降低" OnContent="FSR 延迟降低" Toggled="toggleswitch_FsrLatencyReduction_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_FsrLatencyReduction_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <!-- FSR Multi Frame Generation Ratio -->
                                    <StackPanel x:Name="stackpanel_FsrMultiFrameGenerationRatio">
                                        <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="选择 FSR 多帧生成使用的帧率倍数，倍数越高画面越流畅，但根据游戏内运动的剧烈程度可能会产生更多画面异常。"/>
                                            <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅在 RDNA4 或更新的显卡上有效。&#10;&#10;* 此设置仅对白名单中的应用程序有效。"/>
                                            <Image Source="/Assets/Experimental.png" Width="20" Height="20" ToolTipService.ToolTip="这是一个用于测试目的的实验性设置。"/>
                                            <TextBlock Text="FSR 多帧生成比例" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_FsrMultiFrameGenerationRatio_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_FsrMultiFrameGenerationRatio" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_FsrMultiFrameGenerationRatio_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>

                                    <!-- FSR Show information in-game -->
                                    <StackPanel x:Name="stackpanel_FsrShowInformation">
                                        <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="在运行中的应用程序里显示调试（水印）信息，例如 FSR 版本号。"/>
                                            <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅在应用程序使用 FSR 3.1.5 或更新版本时有效。"/>
                                            <Image Source="/Assets/Experimental.png" Width="20" Height="20" ToolTipService.ToolTip="这是一个用于测试目的的实验性设置。"/>
                                            <ToggleSwitch x:Name="toggleswitch_FsrShowInformation" Margin="10,0,0,0" OffContent="FSR 显示信息" OnContent="FSR 显示信息" Toggled="toggleswitch_FsrShowInformation_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_FsrShowInformation_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="FSR 覆盖" FontSize="20" FontWeight="Medium"/>

                            <!-- Radeon FSR Override -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- FSR Upscaling Override -->
                                    <StackPanel Orientation="Horizontal">
