                                            <Slider Grid.Column="2" x:Name="slider_Fan_Temp_4" ValueChanged="slider_Fan_ValueChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </VariableSizedWrapGrid>
                        </StackPanel>

                        <!-- Display -->
                        <StackPanel x:Name="stackpanel_Display" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="显示选项" FontSize="20" FontWeight="Medium"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Image x:Name="image_Display_Used" Source="/Assets/Checkmark.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="此应用程序配置正在使用中。"/>
                                    <Image Source="/Assets/Warning.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="* 只有 RadeonTuner 运行时，显示应用程序配置才会自动应用。&#10;&#10;* 启动应用程序时，应用程序配置可能需要几秒钟才会生效。&#10;&#10;* 显示、HDR、缩放、功耗、格式和覆盖等部分设置不适用于应用程序配置。"/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Display Resolution -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="显示分辨率" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Resolution_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Display_Resolution" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_Resolution_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:DisplayDetailsIdl">
                                                <TextBlock Text="{x:Bind Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Display Refresh Rate -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="显示刷新率" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_RefreshRate_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Display_RefreshRate" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_RefreshRate_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:DisplayDetailsIdl">
                                                <TextBlock Text="{x:Bind Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Display Orientation -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="显示方向" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Orientation_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Display_Orientation" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_Orientation_SelectionChanged"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="HDR 选项" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <!-- High Dynamic Range -->
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="为显示器启用高动态范围，从而呈现更宽广的色彩范围，提升画面质量。"/>
                                    <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置需要支持高动态范围（HDR）的显示器。&#10;&#10;* 未使用 4:4:4 像素格式时无法启用 HDR。"/>
                                    <ToggleSwitch x:Name="toggleswitch_Display_HdrEnabled" Margin="10,0,0,0" OffContent="高动态范围" OnContent="高动态范围" Toggled="toggleswitch_Display_HdrEnabled_Toggled"/>
                                    <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_HdrEnabled_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="FreeSync 选项" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- FreeSync Mode -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="AMD FreeSync 技术可减少或消除游戏和视频播放过程中的画面伪影、输入延迟、画面撕裂和卡顿。&#10;&#10;- 可变：动态将 FreeSync 刷新率调整为以全屏模式运行的应用程序的帧率。&#10;&#10;- 静态：将 FreeSync 刷新率调整为您设定的显示刷新率。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置需要兼容 AMD FreeSync 的监视器和显卡。&#10;&#10;* 根据应用程序的不同，此设置可能仅在全程全屏模式下有效。&#10;&#10;* 此设置仅对未被列入黑名单的应用程序有效，某些应用程序（例如网页浏览器和视频播放器）可能被禁止使用 FreeSync。"/>
                                        <TextBlock Text="AMD FreeSync / VRR / Adaptive Sync" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_FreeSyncMode_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Display_FreeSyncMode" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_FreeSyncMode_SelectionChanged"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="缩放选项" FontSize="20" FontWeight="Medium"/>

                            <!-- Virtual Super Resolution -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="虚拟超级分辨率 (VSR) 允许应用程序以高于显示器原生分辨率的规格进行渲染，然后将图像缩小以匹配显示器，从而以牺牲性能为代价获得更高质量的画面。&#10;&#10;对于缺少抗锯齿选项或抗锯齿效果不足的游戏，VSR 很有帮助，这种情况在老游戏中较为常见。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_VSR" Margin="10,0,0,0" OffContent="AMD 虚拟超级分辨率" OnContent="AMD 虚拟超级分辨率" Toggled="toggleswitch_Display_VSR_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_VSR_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- GPU Scaling -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="GPU 缩放使用 GPU 将较低分辨率放大以适配显示。&#10;&#10;未启用时，显示器通常自行处理缩放。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_GpuScaling" Margin="10,0,0,0" OffContent="GPU 缩放" OnContent="GPU 缩放" Toggled="toggleswitch_Display_GpuScaling_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_GpuScaling_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Integer Scaling -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="整数缩放会让放大以适应显示器的图像呈现锐利的像素化外观，无法缩放至与显示器精确尺寸和形状匹配的图像将在屏幕居中显示。&#10;&#10;整数缩放可增强老游戏的画面，在现代显示器上重现复古游戏体验。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_IntegerScaling" Margin="10,0,0,0" OffContent="整数缩放" OnContent="整数缩放" Toggled="toggleswitch_Display_IntegerScaling_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_IntegerScaling_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Scaling Mode -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="用于拉伸和定位图像以适配显示的方法。&#10;&#10;- 保持宽高比：在图像适配显示的同时保持其原始宽高比。&#10;&#10;- 全屏面板：拉伸图像以填满整个显示。&#10;&#10;- 居中：将图像居中显示，保持原始宽高比和像素比。"/>
                                            <TextBlock Text="缩放模式" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ScalingMode_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_ScalingMode" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_ScalingMode_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="电源选项" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Vari-Bright -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="Vari-Bright 根据图像内容自适应调整显示亮度，从而节省功耗。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此功能仅在笔记本电脑上可用。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_VariBright" Margin="10,0,0,0" OffContent="Vari-Bright" OnContent="Vari-Bright" Toggled="toggleswitch_Display_VariBright_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_VariBright_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Vari-Bright Level -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Vari-Bright 级别" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_VariBright_Level_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_VariBright_Level" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_VariBright_Level_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="格式选项" FontSize="20" FontWeight="Medium"/>

                            <!-- Color Depth -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="显示器使用的色深。"/>
                                            <TextBlock Text="色深" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ColorDepth_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_ColorDepth" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_ColorDepth_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Pixel Format -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="用于为显示器编码图像的像素格式。"/>
                                            <TextBlock Text="像素格式" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_PixelFormat_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_PixelFormat" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_PixelFormat_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Color Adjustment -->
                            <TextBlock Text="颜色调整" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Brightness -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="亮度" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Brightness_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Brightness" Text="{Binding ElementName=slider_Display_Brightness, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Brightness" Margin="10,0,0,0" ValueChanged="slider_Display_Brightness_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Contrast -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Text="对比度" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Contrast_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Contrast" Text="{Binding ElementName=slider_Display_Contrast, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Contrast" Margin="10,0,0,0" ValueChanged="slider_Display_Contrast_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Saturation -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Text="饱和度" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Saturation_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>

                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Saturation" Text="{Binding ElementName=slider_Display_Saturation, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Saturation" Margin="10,0,0,0" ValueChanged="slider_Display_Saturation_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Hue -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Text="色相" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Hue_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Hue" Text="{Binding ElementName=slider_Display_Hue, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Hue" Margin="10,0,0,0" ValueChanged="slider_Display_Hue_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Display Color Enhancement -->
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="内置 LUT 配置文件，可提升显示内容的清晰度和色彩鲜艳度。&#10;&#10;- 鲜艳游戏：增强整体亮度和色彩丰富度。&#10;&#10;- 动态对比度：提升暗淡细节的可见度。"/>
                                            <TextBlock Text="显示色彩增强" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_DisplayColorEnhancement_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_DisplayColorEnhancement" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_DisplayColorEnhancement_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Color Temperature -->
                            <TextBlock Text="色温" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Control -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="启用或禁用色温控制。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 禁用 'Color Temperature Control' 时，色彩将被限制在较窄的色域内，在已启用 HDR 的显示器上可能导致过饱和和色彩不准。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_ColorTemperature_Control" Margin="10,0,0,0" OffContent="色温控制" OnContent="色温控制" Toggled="toggleswitch_Display_ColorTemperature_Control_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ColorTemperature_Control_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Kelvin -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="选择图像在显示器上显示的冷暖色调。"/>
                                        <TextBlock Text="色温 Kelvin" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ColorTemperature_Kelvin_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_ColorTemperature" Text="{Binding ElementName=slider_Display_ColorTemperature_Kelvin, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_ColorTemperature_Kelvin" Margin="10,0,0,0" ValueChanged="slider_Display_ColorTemperature_Kelvin_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Color Deficiency Correction -->
                            <TextBlock Text="色觉缺陷校正" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Control -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="启用或禁用无障碍模式，让存在不同程度色觉缺陷校正需求的用户可以调整颜色。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_CVDC_Control" Margin="10,0,0,0" OffContent="色觉缺陷校正控制" OnContent="色觉缺陷校正控制" Toggled="toggleswitch_Display_CVDC_Control_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_CVDC_Control_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Protanopia -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="针对红色盲的调整。"/>
                                        <TextBlock Text="红色盲校正" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Protanopia_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Protanopia" Text="{Binding ElementName=slider_Display_Protanopia, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Protanopia" Margin="10,0,0,0" ValueChanged="slider_Display_Protanopia_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Deuteranopia -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="针对绿色盲的调整。"/>
                                        <TextBlock Text="绿色盲校正" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Deuteranopia_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Deuteranopia" Text="{Binding ElementName=slider_Display_Deuteranopia, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Deuteranopia" Margin="10,0,0,0" ValueChanged="slider_Display_Deuteranopia_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Tritanopia -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="针对蓝色盲的调整。"/>
                                        <TextBlock Text="蓝色盲校正" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Tritanopia_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Display_Tritanopia" Text="{Binding ElementName=slider_Display_Tritanopia, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Display_Tritanopia" Margin="10,0,0,0" ValueChanged="slider_Display_Tritanopia_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Override Options -->
                            <TextBlock Text="覆盖选项" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>

                            <!-- HDCP Support -->
                            <Border Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="如果此显示器上禁用了高带宽数字内容保护 (HDCP)，受数字保护的内容可能无法播放，或以较低分辨率播放。"/>
                                        <Image Source="/Assets/WarningRed.png" Width="24" Height="24" ToolTipService.ToolTip="* 需要重启系统才能生效。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_HDCPSupport" Margin="10,0,0,0" OffContent="HDCP 支持" OnContent="HDCP 支持" Toggled="toggleswitch_Display_HDCPSupport_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_HDCPSupport_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Custom Resolutions -->
                            <TextBlock Text="自定义分辨率" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="创建自定义分辨率，或对显示器刷新率进行超频。"/>
                                    <Button x:Name="button_CustomResolution_Create" Margin="10,0,0,0" Content="创建自定义分辨率" Click="button_CustomResolution_ShowHide_Click" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="创建新的自定义分辨率"/>
                                    <Button x:Name="button_CustomResolution_Remove" Content="删除自定义分辨率" Click="button_CustomResolution_Remove_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="删除自定义分辨率"/>
                                </StackPanel>
                            </Border>

                            <!-- Eyefinity Options -->
                            <TextBlock Text="Eyefinity 选项" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Automatic Eyefinity -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="Eyefinity 允许您将多个显示器组合成一块大屏幕。&#10;&#10;自动 Eyefinity 会在显示配置文件应用程序运行时自动启用 Eyefinity，并在其停止运行时禁用。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 启动应用程序后，Eyefinity 可能需要几秒钟才能激活。&#10;&#10;* 此设置仅在 RadeonTuner 运行时生效。"/>
                                        <Image x:Name="image_Eyefinity_Automatic_Profile_Used" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="自动 Eyefinity 已在某个应用程序配置上启用并正在控制当前状态，如果你想手动控制 Eyefinity，请在所有应用程序配置上禁用 '自动 Eyefinity'。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Eyefinity_Automatic" Margin="10,0,0,0" OffContent="自动 Eyefinity" OnContent="自动 Eyefinity" Toggled="toggleswitch_Eyefinity_Automatic_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Eyefinity_Automatic_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Buttons Eyefinity -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="button_Eyefinity_Manage" Content="管理 Eyefinity" Click="button_Eyefinity_Manage_Click" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="管理 Eyefinity 配置。"/>
                                        <Button x:Name="button_Eyefinity_Enable" Content="启用 Eyefinity" Click="button_Eyefinity_Enable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="当 Eyefinity 处于非活动状态时启用它。"/>
                                        <Button x:Name="button_Eyefinity_Disable" Content="禁用 Eyefinity" Click="button_Eyefinity_Disable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 处于活动状态时禁用它。"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Multimedia -->
                        <StackPanel x:Name="stackpanel_Multimedia" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="视频选项" FontSize="20" FontWeight="Medium"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Image x:Name="image_Multimedia_Used" Source="/Assets/Checkmark.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="此应用程序配置正在使用中。"/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Video Upscaling -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="视频超分辨率通过提升视频播放分辨率并调整细节来改善视频播放质量，带来更好的视觉体验。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅适用于 RDNA3 及更新的显卡。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Video_Upscaling" Margin="10,0,0,0" OffContent="视频超分辨率" OnContent="视频超分辨率" Toggled="toggleswitch_Video_Upscaling_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Video_Upscaling_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <!-- Sharpening amount -->
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Text="锐化强度"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Video_Sharpening_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_VideoUpscale_Sharpening" Text="{Binding ElementName=slider_Video_Sharpening, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Video_Sharpening" Margin="10,0,0,0" ValueChanged="slider_Video_Sharpening_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Video Brightness -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="视频亮度"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Video_Brightness_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Video_Brightness" Text="{Binding ElementName=slider_Video_Brightness, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Video_Brightness" Margin="10,0,0,0" ValueChanged="slider_Video_Brightness_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Settings -->
                        <StackPanel x:Name="stackpanel_Settings" Visibility="Collapsed">
                            <TextBlock Text="启动设置" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="Windows 启动时自动启动 RadeonTuner。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Shortcut_Startup" Margin="10,0,0,0" OffContent="Windows 启动时运行" OnContent="Windows 启动时运行" Toggled="toggleswitch_Shortcut_Startup_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="将 RadeonTuner 快捷方式添加到开始菜单应用程序列表。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Shortcut_StartMenu" Margin="10,0,0,0" OffContent="将应用程序添加到开始菜单" OnContent="将应用程序添加到开始菜单" Toggled="toggleswitch_Shortcut_StartMenu_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,5,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="将 RadeonTuner 添加到 Windows 桌面右键菜单中。"/>
                                        <Image x:Name="toggleswitch_Shortcut_ContextMenu_AdminShield" Source="/Assets/Shield.png" Width="24" Height="24" ToolTipService.ToolTip="更改此设置需要管理员权限，启用此设置后你可以继续以普通用户身份使用 RadeonTuner。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Shortcut_ContextMenu" Margin="10,0,0,0" OffContent="将应用程序添加到右键菜单" OnContent="将应用程序添加到右键菜单" Toggled="toggleswitch_Shortcut_ContextMenu_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="窗口设置" FontSize="20" FontWeight="Medium" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="启动此应用程序时显示设置窗口。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 当已有另一个 RadeonTuner 实例在运行时，此设置将被忽略，并会显示已运行实例的窗口。"/>
                                        <ToggleSwitch x:Name="toggleswitch_StartWindowVisible" Margin="10,0,0,0" OffContent="启动时显示窗口" OnContent="启动时显示窗口" Toggled="toggleswitch_StartWindowVisible_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="将此窗口显示在其他应用程序之上。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Window_Top" Margin="10,0,0,0" OffContent="窗口置顶显示" OnContent="窗口置顶显示" Toggled="toggleswitch_Window_Top_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="关闭应用程序时最小化到系统托盘菜单，而不是退出。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Close_Tray" Margin="10,0,0,0" OffContent="关闭时最小化到系统托盘" OnContent="关闭时最小化到系统托盘" Toggled="toggleswitch_Close_Tray_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="更新设置" FontSize="20" FontWeight="Medium" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="启动此应用程序时检查是否有可用的应用程序更新。"/>
                                        <ToggleSwitch x:Name="toggleswitch_StartCheckUpdate" Margin="10,0,0,0" OffContent="启动时检查更新" OnContent="启动时检查更新" Toggled="toggleswitch_StartCheckUpdate_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="实验性设置" FontSize="20" FontWeight="Medium" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="显示用于测试目的的实验性设置，其中部分设置使用占位值。"/>
                                        <ToggleSwitch x:Name="toggleswitch_ShowExperimental" Margin="10,0,0,0" OffContent="显示实验性设置" OnContent="显示实验性设置" Toggled="toggleswitch_ShowExperimental_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="RadeonTuner 会向驱动程序查询某项显卡功能是否受支持，启用此设置可跳过该检查，从而启用不受支持的功能以进行测试。"/>
                                        <ToggleSwitch x:Name="toggleswitch_SkipSupportCheckGraphics" Margin="10,0,0,0" OffContent="跳过显卡支持检查" OnContent="跳过显卡支持检查" Toggled="toggleswitch_SkipSupportCheckGraphics_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Information -->
                        <StackPanel x:Name="stackpanel_Information" Visibility="Collapsed">
                            <TextBlock Text="GPU 信息" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <TextBlock x:Name="textblock_GpuInfo" Text="..."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="显示信息" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <TextBlock x:Name="textblock_DisplayInfo" Text="..."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="应用程序信息" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <TextBlock x:Name="textblock_AppInfo" Text="..."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Overlay - Manage Eyefinity -->
        <Grid x:Name="grid_Overlay_ManageEyefinity" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <StackPanel MinWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="8,8,0,0" Background="{ThemeResource ApplicationDarkGrayColor}" Padding="10">
                    <TextBlock Text="管理 Eyefinity" TextWrapping="Wrap" FontSize="24" Foreground="{ThemeResource ApplicationWhiteColor}"/>
                </Border>
                <Border CornerRadius="0,0,8,8" Background="{ThemeResource ApplicationVoidGrayColor}" Padding="10">
                    <StackPanel>
                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Image Source="/Assets/Warning.png" Width="28" Height="28" ToolTipService.ToolTip="* Eyefinity 仅在连接了多个显示器、且这些显示器已开启并处于复制或扩展显示模式时才能工作。&#10;&#10;* 需要先启用 Eyefinity 才能删除配置。&#10;&#10;* 创建或启用 Eyefinity 后，请确认已设置正确的分辨率。&#10;&#10;* 如果创建后无法删除或禁用 Eyefinity，请尝试用相同的设置创建一个新的配置。"/>
                            <Button x:Name="button_Eyefinity_Overlay_Create" Content="创建 Eyefinity" Click="button_Eyefinity_Overlay_Create_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="根据以下设置创建配置并启用 Eyefinity。"/>
                            <Button x:Name="button_Eyefinity_Overlay_Remove" Content="移除 Eyefinity" Click="button_Eyefinity_Overlay_Remove_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除配置并禁用 Eyefinity。"/>
                            <Button x:Name="button_Eyefinity_Overlay_Enable" Content="启用 Eyefinity" Click="button_Eyefinity_Enable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="当 Eyefinity 处于非活动状态时启用它。"/>
                            <Button x:Name="button_Eyefinity_Overlay_Disable" Content="禁用 Eyefinity" Click="button_Eyefinity_Disable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 处于活动状态时禁用它。"/>
                            <Button x:Name="button_Eyefinity_Overlay_Close" Content="关闭" Click="button_Eyefinity_Manage_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="关闭 Eyefinity 管理浮层。"/>
                        </StackPanel>

                        <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                        <!-- Rows -->
                        <TextBlock Text="水平排列显示器" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ElementName=slider_Eyefinity_Rows, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                            <Slider Grid.Column="1" x:Name="slider_Eyefinity_Rows" Margin="10,0,0,0" Minimum="1" Maximum="6"/>
                        </Grid>

                        <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                        <!-- Columns -->
                        <TextBlock Text="垂直显示器" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ElementName=slider_Eyefinity_Columns, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                            <Slider Grid.Column="1" x:Name="slider_Eyefinity_Columns" Margin="10,0,0,0" Minimum="1" Maximum="6"/>
                        </Grid>

                        <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                        <!-- Display Placement Order -->
                        <TextBlock Text="显示器排列顺序" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="/Assets/DragDrop.png" Width="30" Height="30" ToolTipService.ToolTip="按照你希望从左到右、从上到下的顺序拖放显示器。"/>
                            <ListView Grid.Column="1" x:Name="listview_EyefinityMonitorIndex" Margin="5,0,0,0" Height="40" SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DisplayDetailsIdl">
                                        <Border CornerRadius="4" BorderThickness="2" BorderBrush="{ThemeResource ApplicationDimGrayColor}" Margin="-10">
                                            <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" Margin="5"/>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                        <!-- Display Orientation -->
                        <TextBlock Text="显示方向" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="combobox_EyefinityMonitorOrientation" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Overlay - Custom Resolution -->
        <Grid x:Name="grid_Overlay_CustomResolution" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <StackPanel MinWidth="520" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="8,8,0,0" Background="{ThemeResource ApplicationDarkGrayColor}" Padding="10">
                    <TextBlock Text="自定义分辨率" TextWrapping="Wrap" FontSize="24" Foreground="{ThemeResource ApplicationWhiteColor}"/>
                </Border>
                <Border CornerRadius="0,0,8,8" Background="{ThemeResource ApplicationVoidGrayColor}" Padding="10">
                    <StackPanel>
                        <!-- Timing Standard -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="时序标准" VerticalAlignment="Center"/>
                                <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="用于显示时序计算的标准。&#10;&#10;- Display Timings (Display)&#10;当前显示器正在使用的时序，仅对已有的分辨率和刷新率有效。&#10;&#10;- Coordinated Video Timings (CVT)&#10;VESA 标准，用于生成和定义显示时序。&#10;&#10;- Coordinated Video Timings Reduced Blanking (CVT-RB)&#10;减少消隐期，从而可使用更低的像素时钟频率和更高的帧率。&#10;&#10;- Generalized Timing Formula (GTF)&#10;一种生成行业标准显示时序的方法。&#10;&#10;- Display Monitor Timings (DMT)&#10;VESA 标准，列出各种分辨率和显示尺寸的预设显示时序。"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1" x:Name="combobox_CustomResolution_TimingStandard" Width="300" Style="{ThemeResource ApplicationComboBox}" HorizontalAlignment="Right" SelectionChanged="combobox_CustomResolution_TimingStandard_SelectionChanged"/>
                        </Grid>

                        <Border Margin="0,10,0,5" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                        <!-- Resolution -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="分辨率（像素）" VerticalAlignment="Center"/>
                                <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="显示屏上的水平像素数（从左到右）和垂直像素数（从上到下）。"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="textbox_CustomResolution_Width" Width="129" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_Resolution_TextChanged"/>
                                <TextBlock Text="W" Margin="5,0,8,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="textbox_CustomResolution_Height" Width="129" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_Resolution_TextChanged"/>
                                <TextBlock Text="H" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Refresh Rate -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="刷新率 (Hz)" VerticalAlignment="Center"/>
                                <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="屏幕每秒重绘的次数，以赫兹为单位。"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="textbox_CustomResolution_RefreshRate" Width="278" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_RefreshRate_TextChanged"/>
                                <TextBlock Text="Hz" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Presentation -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="演示" VerticalAlignment="Center"/>
                                <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="图像呈现到屏幕的方式。&#10;&#10;- Progressive：整幅画面一次性绘制完成，可大幅减少屏幕闪烁。&#10;&#10;- Interlaced：一次只在屏幕上显示一半画面，另一半画面紧接着显示。"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1" x:Name="combobox_CustomResolution_Presentation" Width="300" Style="{ThemeResource ApplicationComboBox}" HorizontalAlignment="Right" SelectionChanged="combobox_CustomResolution_Presentation_SelectionChanged"/>
                        </Grid>

                        <Border Margin="0,10,0,10" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                        <!-- Manual settings -->
                        <StackPanel x:Name="stackpanel_CustomResolution_Manual">
                            <!-- Pixel Clock -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="像素时钟 (MHz)" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="在一个刷新周期内传输像素的速度。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_CustomResolution_PixelClock" Width="266" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_PixelClock_TextChanged"/>
                                    <TextBlock Text="MHz" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Actual Refresh Rate -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="实际刷新率 (Hz)" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="GPU 每秒可写入显存的最大像素数量。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_CustomResolution_ActualRefreshRate" Width="278" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" IsEnabled="False"/>
                                    <TextBlock Text="Hz" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,10" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                            <!-- Timing Total -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="时序总计" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="每次同步的水平与垂直像素总数。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_TimingTotal_Horizontal" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingTotal_TextChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="textbox_TimingTotal_Vertical" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingTotal_TextChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timing Front Porch -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="时序前肩" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="有效区域结束位置与下一个同步信号之间的水平和垂直像素数。（从显示器右侧/底部边缘到实际图像最右/最下边缘的距离）"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_TimingFrontPorch_Horizontal" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingFrontPorch_TextChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="textbox_TimingFrontPorch_Vertical" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingFrontPorch_TextChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timing Sync Width -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="时序同步宽度" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="同步期间水平与垂直像素的数量。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_TimingSyncWidth_Horizontal" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingSyncWidth_TextChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="textbox_TimingSyncWidth_Vertical" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingSyncWidth_TextChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timing Sync Polarity -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="时序同步极性" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Information.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="同步信号的水平与垂直极性。&#10;&#10;正值使信号为高电平有效，负值使信号为低电平有效。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="combobox_TimingPolarity_Horizontal" Width="118" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_TimingPolarity_SelectionChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="combobox_TimingPolarity_Vertical" Width="118" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_TimingPolarity_SelectionChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Buttons -->
                        <Button x:Name="button_Overlay_CustomResolution_Create" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_CustomResolution_Create_Click" Content="创建" Style="{ThemeResource ApplicationButton}"/>
                        <Button x:Name="button_Overlay_CustomResolution_Close" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_CustomResolution_Close_Click" Content="关闭" Style="{ThemeResource ApplicationButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Overlay - Confirm Resolution -->
        <Grid x:Name="grid_Overlay_ConfirmResolution" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <StackPanel MinWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="8,8,0,0" Background="{ThemeResource ApplicationDarkGrayColor}" Padding="10">
                    <TextBlock x:Name="textblock_Overlay_ConfirmResolution_Text" Text="保留显示设置？" TextWrapping="Wrap" FontSize="24" Foreground="{ThemeResource ApplicationWhiteColor}"/>
                </Border>
                <Border CornerRadius="0,0,8,8" Background="{ThemeResource ApplicationVoidGrayColor}" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="textblock_Overlay_ConfirmResolution_SubText" Text="..." TextWrapping="Wrap" FontSize="18" Foreground="{ThemeResource ApplicationDimGrayColor}"/>
                        <Button x:Name="button_Overlay_ConfirmResolution" Margin="0,15,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_ConfirmResolution_Click" Content="保留设置" Background="{ThemeResource ApplicationValidBrush}" Style="{ThemeResource ApplicationButton}"/>
                        <Button x:Name="button_Overlay_RevertResolution" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_RevertResolution_Click" Content="还原设置" Background="{ThemeResource ApplicationInvalidBrush}" Style="{ThemeResource ApplicationButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Overlay - MessageBox -->
        <Grid x:Name="grid_Overlay_MessageBox" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <StackPanel MinWidth="300" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="8,8,0,0" Background="{ThemeResource ApplicationDarkGrayColor}" Padding="10">
                    <TextBlock x:Name="textblock_Overlay_MessageBox_Text" Text="..." TextWrapping="Wrap" FontSize="24" Foreground="{ThemeResource ApplicationWhiteColor}"/>
                </Border>
                <Border CornerRadius="0,0,8,8" Background="{ThemeResource ApplicationVoidGrayColor}" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="textblock_Overlay_MessageBox_SubText" Text="..." TextWrapping="Wrap" FontSize="18" Foreground="{ThemeResource ApplicationDimGrayColor}"/>
                        <ListView x:Name="listview_Overlay_MessageBox" MaxHeight="300" Margin="0,10,0,0" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="listview_Overlay_MessageBox_ItemClick" Style="{ThemeResource ApplicationListView}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Overlay - AppPicker -->
        <Grid x:Name="grid_Overlay_AppPicker" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <StackPanel MinWidth="300" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="8,8,0,0" Background="{ThemeResource ApplicationDarkGrayColor}" Padding="10">
                    <TextBlock x:Name="textblock_Overlay_AppPicker_Text" Text="添加应用程序" TextWrapping="Wrap" FontSize="24" Foreground="{ThemeResource ApplicationWhiteColor}"/>
                </Border>
                <Border CornerRadius="0,0,8,8" Background="{ThemeResource ApplicationVoidGrayColor}" Padding="10">
                    <StackPanel>
                        <ListView x:Name="listview_Overlay_AppPicker" MaxHeight="420" SelectionMode="Multiple" IsItemClickEnabled="True" ItemClick="listview_Overlay_AppPicker_ItemClick" Style="{ThemeResource ApplicationListView}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppPickerIdl">
                                    <Grid Height="100">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{x:Bind IconPath}" Width="40" Height="40"/>
                                        <StackPanel Grid.Row="1" Margin="0,5,0,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind Detail}" TextWrapping="NoWrap" HorizontalAlignment="Center" Foreground="{ThemeResource ApplicationDimGrayColor}" ToolTipService.ToolTip="{x:Bind Detail}"/>
                                            <TextBlock Text="{x:Bind AppName}" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Center" Foreground="{ThemeResource ApplicationWhiteBrush}" ToolTipService.ToolTip="{x:Bind AppName}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="button_Overlay_AppPicker_Confirm" HorizontalAlignment="Stretch" Click="button_Overlay_AppPicker_Confirm_Click" Content="确认" Style="{ThemeResource ApplicationButton}"/>
                            <Button Grid.Column="1" x:Name="button_Overlay_AppPicker_Cancel" Margin="10,0,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_AppPicker_Cancel_Click" Content="取消" Style="{ThemeResource ApplicationButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Overlay - Notification -->
        <Border x:Name="grid_Overlay_Notification" Margin="0,122,5,0" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationAccentDimColor}" Opacity="0.90"/>
            </Border.Background>
            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="textblock_Notification_Text" Text="..." TextWrapping="Wrap" FontSize="20" TextAlignment="Center" Foreground="{ThemeResource ApplicationWhiteColor}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>