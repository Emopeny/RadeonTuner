                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="在支持的游戏中动态调整分辨率，以最小画质影响提升性能。&#10;&#10;Radeon Boost 算法可配置为监测游戏内场景细节和/或用户输入。&#10;&#10;- 基于输入：主要根据鼠标或手柄输入调整外围区域的分辨率，在快速移动时降低延迟并提升性能。&#10;&#10;- 基于场景：分析游戏内画面，仅对低细节区域降低分辨率，在关键区域保持画质的同时提升性能。&#10;&#10;- 多模态：结合基于场景与基于输入的分析，在瞄准或移动时进一步获得性能提升并降低延迟。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅对白名单中的应用程序生效；如需绕过驱动检查，可以把应用程序的可执行文件重命名为 'sottr.exe'&#10;&#10;* 启用 'Radeon Chill' 时无法使用此设置。&#10;&#10;* 此设置仅适用于 RDNA2 或更新的显卡。"/>
                                        <Image x:Name="image_RadeonBoost_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                        <TextBlock Margin="10,0,0,0" Text="Radeon Boost 2" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonBoost_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_RadeonBoost" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_RadeonBoost_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="最小分辨率" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonBoost_MinResolution_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_RadeonBoost_MinRes" Text="{Binding ElementName=slider_RadeonBoost_MinResolution, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_RadeonBoost_MinResolution" Margin="10,0,0,0" ValueChanged="slider_RadeonBoost_MinResolution_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="锐化选项" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Radeon Image Sharpening 1 -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="Radeon 图像锐化可为游戏画面恢复被其他效果柔化的清晰度，适用于部分生产力和媒体应用程序。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 启用 HDR 时以及 OpenGL 应用程序中，此设置无效。&#10;&#10;* 此设置仅在使用全屏模式时有效。&#10;&#10;* 在应用程序配置文件中，此设置仅适用于 RDNA 及更新的显卡。&#10;&#10;* DirectX 9 应用程序仅在 RDNA 及更新的显卡上受支持。"/>
                                        <Image x:Name="image_RadeonImageSharpening1_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                        <ToggleSwitch x:Name="toggleswitch_RadeonImageSharpening1" Margin="10,0,0,0" OffContent="Radeon 图像锐化 1" OnContent="Radeon 图像锐化 1" Toggled="toggleswitch_RadeonImageSharpening1_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening1_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <!-- Radeon Image Sharpening 1 Sharpening -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="锐化强度" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening1_Sharpening_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_RadeonImageSharpening1_Sharpening" Text="{Binding ElementName=slider_RadeonImageSharpening1_Sharpening, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_RadeonImageSharpening1_Sharpening" Margin="10,0,0,0" ValueChanged="slider_RadeonImageSharpening1_Sharpening_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Radeon Image Sharpening 2 -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="Radeon 图像锐化可为游戏画面恢复被其他效果柔化的清晰度，适用于部分生产力和媒体应用程序。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅在 RDNA4 或更新的显卡上有效。&#10;&#10;* 此设置仅在使用全屏模式时有效，除非你同时启用 'Sharpen Desktop' 选项。"/>
                                        <Image x:Name="image_RadeonImageSharpening2_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                        <ToggleSwitch x:Name="toggleswitch_RadeonImageSharpening2" Margin="10,0,0,0" OffContent="Radeon 图像锐化 2" OnContent="Radeon 图像锐化 2" Toggled="toggleswitch_RadeonImageSharpening2_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening2_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <!-- Radeon Image Sharpening 2 Desktop -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="对桌面和应用程序（包括窗口化应用程序）应用锐化。"/>
                                        <ToggleSwitch x:Name="toggleswitch_RadeonImageSharpening2_Desktop" Margin="10,0,0,0" OffContent="锐化桌面" OnContent="锐化桌面" Toggled="toggleswitch_RadeonImageSharpening2_Desktop_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening2_Desktop_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <!-- Radeon Image Sharpening 2 Sharpening -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="锐化强度" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening2_Sharpening_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_RadeonImageSharpening2_Sharpening" Text="{Binding ElementName=slider_RadeonImageSharpening2_Sharpening, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_RadeonImageSharpening2_Sharpening" Margin="10,0,0,0" ValueChanged="slider_RadeonImageSharpening2_Sharpening_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="垂直刷新选项" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Vertical Sync -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="垂直同步会将切换到新动画帧的时机与显示器更新同步，因此帧之间不会出现可见的撕裂。&#10;&#10;* 将帧率限制为显示器的刷新率。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 根据渲染管线的不同，此设置可能仅在独占全屏模式下生效。"/>
                                        <TextBlock Margin="10,0,0,0" Text="垂直同步" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_VerticalSync_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_VerticalSync" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_VerticalSync_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Radeon Enhanced Sync -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="Radeon Enhanced Sync 以低延迟将新动画帧的切换与显示器刷新率同步，因此帧与帧之间几乎看不到撕裂。&#10;&#10;* 不会将帧率限制在显示器的刷新率上。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 视渲染管线而定，此设置可能仅在使用独占全屏模式时生效。&#10;&#10;* 当应用程序不支持 '增强同步' 时，将回退并使用 '垂直同步' 设置。"/>
                                        <ToggleSwitch x:Name="toggleswitch_RadeonEnhancedSync" Margin="10,0,0,0" OffContent="Radeon 增强同步" OnContent="Radeon 增强同步" Toggled="toggleswitch_RadeonEnhancedSync_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonEnhancedSync_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- OpenGL Triple Buffering -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="专供 OpenGL 应用程序使用的替代垂直刷新模式。&#10;&#10;* 不会将帧率限制在显示器的刷新率。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 根据渲染管线的不同，此设置可能仅在独占全屏模式下生效。"/>
                                        <ToggleSwitch x:Name="toggleswitch_OpenGLTripleBuffering" Margin="10,0,0,0" OffContent="OpenGL 三重缓冲" OnContent="OpenGL 三重缓冲" Toggled="toggleswitch_OpenGLTripleBuffering_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_OpenGLTripleBuffering_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="抗锯齿选项" FontSize="20" FontWeight="Medium"/>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <!-- Anti-Aliasing Override -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="抗锯齿通过平滑锯齿边缘来提升画质，代价是牺牲一部分性能和显存占用。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 抗锯齿覆盖、方法、级别和 EQAA 仅适用于 DirectX 9（及更早版本）和部分 OpenGL 应用程序。"/>
                                        <ToggleSwitch x:Name="toggleswitch_AntiAliasingOverride" Margin="10,0,0,0" OffContent="抗锯齿覆盖" OnContent="抗锯齿覆盖" Toggled="toggleswitch_AntiAliasingOverride_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingOverride_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Anti-Aliasing Method -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="选择用于平滑物体边缘的方式，采样越多画质越好，但性能会下降。&#10;&#10;* 多重采样（MSAA）仅针对物体边缘进行处理。&#10;&#10;* 自适应多重采样（Adaptive MSAA）同时平滑边缘与透明纹理。&#10;&#10;* 超级采样（SSAA/FSAA）覆盖每一个像素，画质出色，但性能开销较大。"/>
                                        <TextBlock Text="抗锯齿方法" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingMethod_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_AntiAliasingMethod" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_AntiAliasingMethod_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Anti-Aliasing Level -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="选择用于边缘抗锯齿的采样数，采样数越高画质越好，但会牺牲性能。"/>
                                        <TextBlock Text="抗锯齿级别" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingLevel_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_AntiAliasingLevel" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_AntiAliasingLevel_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Enhanced Quality Anti-Aliasing -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="增强质量抗锯齿（EQAA）是一种抗锯齿技术，可在无需额外显存的情况下对锯齿边缘进行高级平滑处理，但会带来少量额外性能开销。"/>
                                        <ToggleSwitch x:Name="toggleswitch_AntiAliasingEnhancedQuality" Margin="10,0,0,0" OffContent="增强质量抗锯齿" OnContent="增强质量抗锯齿" Toggled="toggleswitch_AntiAliasingEnhancedQuality_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingEnhancedQuality_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Morphological Anti-Aliasing -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="形态抗锯齿（MLAA）是一种对性能影响极小的边缘平滑技术。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅在使用独占全屏模式时有效。&#10;&#10;* 此设置仅对 DirectX 9 应用程序有效。"/>
                                        <ToggleSwitch x:Name="toggleswitch_MorphologicalAntiAliasing" Margin="10,0,0,0" OffContent="形态学抗锯齿" OnContent="形态学抗锯齿" Toggled="toggleswitch_MorphologicalAntiAliasing_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_MorphologicalAntiAliasing_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="纹理选项" FontSize="20" FontWeight="Medium"/>

                            <!-- Anisotropic Texture Filtering Override -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="各向异性过滤可提升大多数 3D 应用中远处或倾斜表面（例如道路或树木）的纹理质量，但会损失一定的帧率性能。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 某些应用程序需要将纹理过滤类型设置为 'Trilinear' 或 'Bilinear'，覆盖才能生效。&#10;&#10;* 此设置对 DirectX 12 和 Vulkan 应用程序无效。"/>
                                        <TextBlock Text="各向异性纹理过滤覆盖" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_AnisotropicTextureFiltering_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_AnisotropicTextureFiltering" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_AnisotropicTextureFiltering_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                </StackPanel>
                            </Border>

                            <!-- Texture Filtering Quality -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="控制纹理过滤的优化点，'Standard' 通常是画质与性能的最佳平衡。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 需要应用程序启用 'Anisotropic' 之类的纹理过滤类型才能生效。&#10;&#10;* 此设置在 DirectX 12 和 Vulkan 应用程序上无效。"/>
                                        <TextBlock Text="纹理过滤质量" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_TextureFilteringQuality_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_TextureFilteringQuality" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_TextureFilteringQuality_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                </StackPanel>
                            </Border>

                            <!-- Surface Format Optimization -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="允许驱动覆盖应用程序的设置，选择更优的纹理格式以提升性能并降低显存占用，通常对图像质量影响极小。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置在 DirectX 12 和 Vulkan 应用程序中无效。"/>
                                        <ToggleSwitch x:Name="toggleswitch_SurfaceFormatOptimization" Margin="10,0,0,0" OffContent="表面格式优化" OnContent="表面格式优化" Toggled="toggleswitch_SurfaceFormatOptimization_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_SurfaceFormatOptimization_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- OpenGL 10-Bit Pixel Format -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="为兼容的显示器和应用程序启用 10 位 OpenGL 纹理支持。"/>
                                    <Image Source="/Assets/WarningRed.png" Width="24" Height="24" ToolTipService.ToolTip="* 启用此设置会破坏 HDR 兼容性。&#10;&#10;* 需要重启系统才能生效。"/>
                                    <ToggleSwitch x:Name="toggleswitch_OpenGL10BitPixelFormat" Margin="10,0,0,0" OffContent="OpenGL 10 位像素格式" OnContent="OpenGL 10 位像素格式" Toggled="toggleswitch_OpenGL10BitPixelFormat_Toggled"/>
                                    <TextBlock Margin="5,0,0,0" x:Name="textblock_OpenGL10BitPixelFormat_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="曲面细分选项" FontSize="20" FontWeight="Medium"/>

                            <!-- Tessellation Mode -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="曲面细分调整用于渲染物体的多边形数量，以增强细节表现，但会消耗一定的帧率性能。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 部分应用程序需要启用 'Tessellation' 才能使覆盖生效。&#10;&#10;* 曲面细分模式和级别仅适用于 DirectX 11 应用程序。"/>
                                        <TextBlock Text="曲面细分模式" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_TessellationMode_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Tessellation_Mode" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Tessellation_Mode_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <!-- Tessellation Level -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="选择对物体进行曲面细分时生成的多边形数量，设置上限可防止过度细分——过度细分对画质和性能几乎没有益处。"/>
                                        <TextBlock Text="曲面细分级别" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_TessellationLevel_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Tessellation_Level" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Tessellation_Level_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Tuning -->
                        <StackPanel x:Name="stackpanel_Tuning" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="保持活动" FontSize="20" FontWeight="Medium"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Image x:Name="image_Tuning_Used" Source="/Assets/Checkmark.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="此应用程序配置正在使用中。"/>
                                    <Image Source="/Assets/Warning.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="* 调校应用程序配置文件仅在 RadeonTuner 运行时才会自动应用。&#10;&#10;* 启动应用程序后，应用配置文件可能需要几秒钟才能生效。"/>
                                </StackPanel>
                            </Grid>

                            <!-- Keep Active -->
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="当配置文件中的调校和风扇设置因系统意外故障或其他原因被 GPU 驱动重置为默认值后，重新应用它们。"/>
                                    <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 在启用保持活动之前，请确保您使用的调校和风扇设置稳定且经过充分测试。&#10;&#10;* 此设置仅在 RadeonTuner 运行时生效。"/>
                                    <ToggleSwitch x:Name="toggleswitch_KeepActive" Width="130" Margin="10,0,0,0" OffContent="保持活动" OnContent="保持活动" Toggled="toggleswitch_KeepActive_Toggled"/>
                                    <TextBlock Margin="5,0,0,0" x:Name="textblock_KeepActive_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU Tuning -->
                            <TextBlock Text="GPU 调校" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整最低显卡频率。"/>
                                        <Image Source="/Assets/Warning.png" Width="24" Height="24" ToolTipService.ToolTip="* 将最低频率设置得接近最高频率可能导致性能大幅下降，请通过测试性能找到最佳平衡点，或保持默认值。"/>
                                        <TextBlock Margin="10,0,0,0" Text="最低频率" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Core_Min_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Core_Min" Text="{Binding ElementName=slider_Core_Min, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Core_Min" ValueChanged="slider_Core_Min_ValueChanged" Margin="10,0,0,0"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整允许的最大显卡频率。"/>
                                        <TextBlock x:Name="textblock_Core_Max" Margin="10,0,0,0" Text="最大频率" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Core_Max_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Core_Max" Text="{Binding ElementName=slider_Core_Max, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Core_Max" ValueChanged="slider_Core_Max_ValueChanged" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Memory Tuning -->
                            <TextBlock Text="显存调校" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整显存时序配置文件，更快的显存延迟时序可提升性能。"/>
                                        <TextBlock Margin="10,0,0,0" Text="显存时序" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Memory_Timing_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <ComboBox x:Name="combobox_Memory_Timing" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Memory_Timing_SelectionChanged"/>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整允许的最大显存频率。"/>
                                        <TextBlock Margin="10,0,0,0" Text="最大频率" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Memory_Max_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Memory_Max" Text="{Binding ElementName=slider_Memory_Max, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Memory_Max" Margin="10,0,0,0" ValueChanged="slider_Memory_Max_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Power Tuning -->
                            <TextBlock Text="功耗调校" Margin="0,10,0,0" FontSize="20" FontWeight="Medium"/>
                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整 GPU 允许的最大功耗，功耗上限越高，性能越强。"/>
                                        <TextBlock Margin="10,0,0,0" Text="功耗上限" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Power_Limit_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Power_Limit" Text="{Binding ElementName=slider_Power_Limit, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Power_Limit" Margin="10,0,0,0" ValueChanged="slider_Power_Limit_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整 GPU 整个频率范围内的电压偏移，电压越低性能越高。"/>
                                        <TextBlock x:Name="textblock_Power_Voltage" Margin="10,0,0,0" Text="电压" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Power_Voltage_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Power_Voltage" Text="{Binding ElementName=slider_Power_Voltage, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Power_Voltage" Margin="10,0,0,0" ValueChanged="slider_Power_Voltage_ValueChanged"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" CornerRadius="2" Height="2" Background="{StaticResource ApplicationDarkGrayBrush}" Opacity="0.20"/>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="调整 GPU 的热设计电流（TDC）上限，TDC 上限越高，性能越强。"/>
                                        <TextBlock Margin="10,0,0,0" Text="TDC 上限" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Power_TDC_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="textbox_Power_TDC" Text="{Binding ElementName=slider_Power_TDC, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                        <Slider Grid.Column="1" x:Name="slider_Power_TDC" Margin="10,0,0,0" ValueChanged="slider_Power_TDC_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Fans -->
                        <StackPanel x:Name="stackpanel_Fans" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="风扇转速与温度选项" FontSize="20" FontWeight="Medium"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Image x:Name="image_Fans_Used" Source="/Assets/Checkmark.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="此应用程序配置正在使用中。"/>
                                    <Image Source="/Assets/Warning.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="* 调校应用程序配置文件仅在 RadeonTuner 运行时才会自动应用。&#10;&#10;* 启动应用程序后，应用配置文件可能需要几秒钟才能生效。"/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="让驱动程序接管 GPU 风扇控制，这样你就能设置自定义风扇曲线；禁用后，GPU 将按 BIOS 中的设定管理风扇。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Fan_Control" Width="128" Margin="10,0,0,0" OffContent="风扇控制" OnContent="风扇控制" Toggled="toggleswitch_Fan_Control_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Control_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Information.png" Width="24" Height="24" ToolTipService.ToolTip="当 GPU 无需散热时关闭风扇，以降低噪音并提高风扇耐用性。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Fan_Zero_Rpm" Width="185" Margin="10,0,0,0" OffContent="风扇零转速模式" OnContent="风扇零转速模式" Toggled="toggleswitch_Fan_Zero_Rpm_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Zero_Rpm_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="grid_Fan_Graph" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="0" BorderBrush="{ThemeResource ApplicationWhiteColor}" BorderThickness="2" CornerRadius="6">
                                    <Grid>
                                        <Border x:Name="border_Fan_Zero_Rpm_Range" Width="0" CornerRadius="6,0,0,6" Background="{ThemeResource ApplicationDarkGrayColor}" HorizontalAlignment="Left" ToolTipService.ToolTip="风扇零转速区间，处于该区间内且显卡温度足够低时，风扇会停止转动。"/>
                                        <Grid Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Line Margin="0,25,0,0" X1="500" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                            <Line Margin="0,50,0,0" X1="500" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                            <Line Margin="0,75,0,0" X1="500" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                            <Line Margin="125,0,0,0" Y1="100" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                            <Line Margin="250,0,0,0" Y1="100" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                            <Line Margin="375,0,0,0" Y1="100" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                            <Line x:Name="grid_Fan_Zero_Rpm_Line_Gpu" Visibility="Collapsed" Margin="275,0,0,0" Y1="99" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeDashArray="3" StrokeDashCap="Round" StrokeThickness="3" ToolTipService.ToolTip="风扇零转速温度，当前设置为"/>
                                            <Line x:Name="grid_Fan_Zero_Rpm_Line_Profile" Visibility="Collapsed" Margin="275,0,0,0" Y1="99" Stroke="{ThemeResource SystemAccentColor}" StrokeDashArray="3" StrokeDashCap="Round" StrokeThickness="3" ToolTipService.ToolTip="风扇零转速温度，配置目标"/>
                                            <Polyline x:Name="polyline_Fan_Lines_Gpu" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" Stroke="{StaticResource ApplicationDimGrayColor}" StrokeThickness="2" ToolTipService.ToolTip="驱动中当前设置为"/>
                                            <Polyline x:Name="polyline_Fan_Lines_Profile" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" Stroke="{StaticResource SystemAccentColor}" StrokeThickness="2" ToolTipService.ToolTip="配置目标"/>
                                        </Grid>
                                        <Grid>
                                            <Ellipse x:Name="ellipse_Fan_Point_0" Margin="0,50,0,0" Width="10" Height="10" Fill="{StaticResource ApplicationWhiteBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="风扇曲线 1"/>
                                            <Ellipse x:Name="ellipse_Fan_Point_1" Margin="125,50,0,0" Width="10" Height="10" Fill="{StaticResource ApplicationWhiteBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="风扇曲线 2"/>
                                            <Ellipse x:Name="ellipse_Fan_Point_2" Margin="250,50,0,0" Width="10" Height="10" Fill="{StaticResource ApplicationWhiteBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="风扇曲线 3"/>
                                            <Ellipse x:Name="ellipse_Fan_Point_3" Margin="375,50,0,0" Width="10" Height="10" Fill="{StaticResource ApplicationWhiteBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="风扇曲线 4"/>
                                            <Ellipse x:Name="ellipse_Fan_Point_4" Margin="500,50,0,0" Width="10" Height="10" Fill="{StaticResource ApplicationWhiteBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="风扇曲线 5"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Stretch">
                                    <TextBlock Text="0% 风扇转速" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="风扇转速 50%" VerticalAlignment="Center"/>
                                    <TextBlock Text="100% 风扇转速" VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="0°C | 32°F" HorizontalAlignment="Left"/>
                                    <TextBlock Text="50°C | 122°F" HorizontalAlignment="Center"/>
                                    <TextBlock Text="100°C | 212°F" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <VariableSizedWrapGrid Orientation="Horizontal" Margin="-5,5,0,0">
                                <Border Width="280" Margin="5" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="风扇曲线 1" FontSize="16" FontWeight="Medium"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Curve_0_Speed_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Curve_0_Temp_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Fan_Speed_0" Text="{Binding ElementName=slider_Fan_Speed_0, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <TextBlock Grid.Column="1" Width="20" Text="%" TextAlignment="Center" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                            <Slider Grid.Column="2" x:Name="slider_Fan_Speed_0" ValueChanged="slider_Fan_ValueChanged"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Fan_Temp_0" Text="{Binding ElementName=slider_Fan_Temp_0, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <TextBlock Grid.Column="1" Width="20" Text="°C" TextAlignment="Center" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                            <Slider Grid.Column="2" x:Name="slider_Fan_Temp_0" ValueChanged="slider_Fan_ValueChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Width="280" Margin="5" Padding="5" CornerRadius="8" Background="{ThemeResource ApplicationVoidGrayColor}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="风扇曲线 2" FontSize="16" FontWeight="Medium"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Curve_1_Speed_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Curve_1_Temp_Value" Foreground="{StaticResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中当前设置为"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Fan_Speed_1" Text="{Binding ElementName=slider_Fan_Speed_1, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <TextBlock Grid.Column="1" Width="20" Text="%" TextAlignment="Center" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                            <Slider Grid.Column="2" x:Name="slider_Fan_Speed_1" ValueChanged="slider_Fan_ValueChanged"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Fan_Temp_1" Text="{Binding ElementName=slider_Fan_Temp_1, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
